# --- Needed before Phase 1 ---

# Supabase (Project Settings > API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider — Anthropic to start, swappable per Section 2 of the builder
# brief. Get this from console.anthropic.com (separate from your Claude
# Code subscription, this key bills per token at runtime).
ANTHROPIC_API_KEY=

# Google Cloud service account (Sheets index + Drive full-content
# archive both run on this one account, Drive API scope enabled on it)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# One workbook per brand (builder-brief.md Section 17.1). Create two
# separate Google Sheets, share each with the service account email
# above, then paste each Sheet's ID here (from its URL).
GOOGLE_SHEETS_BACKUP_ID_LBSTRANSFORMATION=
GOOGLE_SHEETS_BACKUP_ID_LBSWORKS=
# One Drive folder per brand (builder-brief.md Section 17.2), named e.g.
# "LBsTransformation-Dashboard-Backup". Create two folders in your own
# Drive, no sharing needed, Drive writes run as you (see OAuth section
# below), then paste each folder's ID here (from its URL).
GOOGLE_DRIVE_BACKUP_FOLDER_ID_LBSTRANSFORMATION=
GOOGLE_DRIVE_BACKUP_FOLDER_ID_LBSWORKS=

# Drive-specific auth. Service accounts have no Drive storage quota of
# their own, they can edit an existing file shared with them (how
# Sheets works above) but can't create new ones, which the archive needs
# continuously. So Drive writes run as your own Google account via
# OAuth instead. One-time setup: create an OAuth Client ID (Desktop app
# type) in the same Google Cloud project, paste its Client ID/Secret
# below, then run `node scripts/get-drive-refresh-token.mjs` and follow
# its instructions to get the refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Secures /api/cron/backup, the nightly Vercel Cron endpoint. Any random
# string works locally; once deployed, set the same value in the Vercel
# project's env vars, Vercel Cron sends it automatically.
CRON_SECRET=

# --- Phase 2 ---

# YouTube Data API v3. Powers the Research tab's video pull (search +
# view counts + top comments). No path to real transcripts on an
# API-key-only app, captions.download needs the channel owner's own
# OAuth consent, so this is title/description/comments as the real
# signal, not "transcripts, with an occasional fallback."
YOUTUBE_API_KEY=

# Search/SERP API (SerpApi). Powers Google (autocomplete + People Also
# Ask + related searches), Reddit, and Quora in the Research tab. Reddit
# and Quora both run through site-scoped Google searches on this same
# key, not dedicated integrations. Reddit's own official API access was
# not approved after two attempts, this is the actual default path for
# Reddit research, not a temporary workaround.
SERPAPI_KEY=
